# Copy to .env and fill in. Never commit .env. Scripts never print these values.
#
# Phase A runs everything locally: `npm run dev:server` starts a parse-server with FIXED local keys
# (scripts/lib/env.mjs LOCAL — they are not secrets, the server only listens on localhost and the database is a
# throwaway) and `npm run simulator` starts the deterministic provider simulator on port 1344. An empty .env is
# fine for local work. These variables are only read when the scripts and tests are later pointed at a Back4app
# backend (the live phase — coordinator-run; do not run it from this repo until the coordinator says so).
#
# Back4app → your backend app → App Settings → Security & Keys.
# The MASTER_KEY stays optional: scripts/setup.mjs falls back to the Cloud function setupSchema (REST key +
# SETUP_TOKEN, guarded by cloud/config.js) when the key is absent. The master key never needs to leave the dashboard.
APP_ID=
JS_KEY=
REST_KEY=
MASTER_KEY=
SERVER_URL=https://parseapi.back4app.com

# Server-checked admin setup token: the SETUP_ENABLED-gated Cloud functions (setupSchema, testInspect,
# testCleanup) additionally require this value as params.setupToken. Set the same value in the deployed
# cloud/config.js (SETUP_TOKEN) and here. Locally the fixed dev token from scripts/lib/env.mjs is used.
SETUP_TOKEN=

# The real provider key NEVER goes in this file and never in the repo: for the live phase it goes into the
# DEPLOYED copy of cloud/config.js only (gitignored here; uploaded through the dashboard).

# Local development only: Postgres used by the local parse-server (port 5433, brew postgresql@17).
DATABASE_URL=postgres://localhost:5433/llm_dev

# Point the test suite at another server (live phase, later) instead of the in-process local one.
# TEST_SERVER_URL=https://parseapi.back4app.com

# Live phase only: where askLlm should send provider calls if not the real provider (leave unset for the real
# provider; the local test harness sets it to the in-process simulator automatically).
# LLM_PROVIDER_URL=
